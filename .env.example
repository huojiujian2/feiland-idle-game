# ====== .env.example · 生产环境变量模板 · v1.10 ======
# 复制本文件为 .env，填入实际值（.env 不进 git、不进 docker 镜像）

# ===== 必填项 =====

# JWT 签名密钥（生产环境必须！）
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 或：openssl rand -hex 32
JWT_SECRET=

# ===== 选填项（全部有默认值） =====

# 前端对外端口（默认 3000）
PORT=3000

# Node 堆上限（MB；容器内存 ≥ 1GB 时推荐 768）
NODE_MAX_OLD_SPACE_SIZE=512

# 暴露 GC（让内存监控可主动触发 major GC；推荐开）
ENABLE_EXPOSE_GC=1

# 堆监控告警阈值（heapPct ≥ 此值告警）
HEAP_WARN_PCT=80

# 容器内存上限
MEM_LIMIT=1g

# CPU 上限
CPUS=1.0

# CORS 白名单（生产域名，逗号分隔）
CORS_ORIGIN=https://game.example.com,https://www.example.com

# 审计日志（on/off；error 只记失败）
AUDIT_LOG=on

# 镜像 tag（用于 docker-compose image 引用）
IMAGE_TAG=1.10