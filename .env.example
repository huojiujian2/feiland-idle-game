# ============================================
# Docker 部署环境变量示例
# ============================================
# 使用方法：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 修改下面的值
#   3. 运行：docker compose up -d --build

# 宿主机映射端口（容器内固定 3001，这里改的是宿主机端口）
PORT=3001

# 数据库文件路径（容器内路径，一般不需要改）
DB_PATH=/app/data/db.json

# 运行环境
NODE_ENV=production
